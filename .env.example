# =========================================================================
# OwnerCheckAI — .env template
# Sao chép sang .env và (tuỳ chọn) sửa giá trị trước khi `docker compose up`.
#   Linux/Mac: cp .env.example .env
#   Windows PowerShell: Copy-Item .env.example .env
# Lưu ý: KHÔNG commit file .env thật (đã bị .gitignore loại trừ).
# =========================================================================

# -------- PostgreSQL --------
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret
POSTGRES_DB=lpr_database
# Đổi sang `postgresql+psycopg2://<user>:<pass>@db:5432/<db>` nếu thay user/pass/db ở trên.
DATABASE_URL=postgresql+psycopg2://admin:secret@db:5432/lpr_database

# -------- JWT --------
# Sinh key mới cho production: `openssl rand -hex 32`
SECRET_KEY=please-replace-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -------- MinIO (object storage) --------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=secretpassword
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=secretpassword
MINIO_BUCKET=plates
MINIO_SECURE=false

# -------- Qdrant (vector DB) --------
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# -------- Redis (queue + cache + pub/sub) --------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# -------- Recognition queue tuning --------
# TTL của job state trong Redis (giây). Sau TTL, GET /recognition/jobs/{id} sẽ trả 404.
JOB_STATE_TTL_SECONDS=3600

# -------- Camera / RTSP stream ingestor --------
# FPS publish frame cho MJPEG live preview (Redis pub/sub).
CAMERA_PREVIEW_FPS=15
# FPS đẩy frame vào AI queue (worker xử lý). Hạ xuống nếu CPU yếu.
CAMERA_AI_FPS=5
# JPEG encode quality 0-100. 95 ≈ near-lossless, 80 ≈ tiết kiệm băng thông.
CAMERA_JPEG_QUALITY=95

# -------- AI_Engine pipeline tuning --------
AI_DET_CONF=0.2          # YOLO detection confidence (default 0.5)
AI_OCR_SCORE=0.3         # PaddleOCR threshold (default 0.7)
AI_SKIP_QUALITY=1        # 1 = bypass blur check cho RTSP nén lossy
AI_USE_GPU=0             # 1 nếu có GPU NVIDIA + paddlepaddle-gpu

# -------- pgAdmin (chỉ chạy khi `docker compose --profile tools up`) --------
PGADMIN_EMAIL=admin@lpr.local
PGADMIN_PASSWORD=changeme
